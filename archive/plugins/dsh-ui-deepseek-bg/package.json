  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check && node scripts/check-selectors.mjs",
    "check": "node scripts/check-selectors.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
