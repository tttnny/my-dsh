#!/bin/sh
# my-dsh pre-commit：**改了哪个包就在哪个包里跑它自己的 check**，外加一道仓库级台账检查。
#
#
# 四道闸门，按这个顺序：
#   0. 内核基线：改到 plugins/ 或 presets/ 时跑 `node tools/dsh-baseline.mjs --check --only <改动的包>`。
#      **这条不能省**：台账判据 10 拿字面量与本包自己的 engines.dsh 比，判据 11 拿 preset
#      抄本与运行中内核比——两边各自自洽时，整仓一起落后一版没有任何一道闸门看得见。
#      只比本次改动的包：升级顺序是「先 preset、再 plugins」，中间那次提交里其余包必然
#      还落后，整仓比较会把它拦下，逼人用 SKIP_CHECK=1 连另外三道闸门一起跳过。未触及的
#      落后包由 --check 打一行提示，不拦提交。
#      本机没装 DSH 时它回退出码 2，那是「跑不起来」，跳过并说明，不当成不通过。
#   1. 台账：改到 plugins/、presets/、根 README.md、docs/rules/ 或 tools/ 时跑
#      `node tools/assert-ledger.mjs`（判据见该文件头部）。零依赖、纯读文件，很快。
#   2. 包：改到的每个包在它自己目录跑 `pnpm check`。**有 check 就跑**——没有 node_modules
#      也照跑（preset 的 check 本来就不需要依赖），跑不过就拦，不静默少跑一道闸门。
#   3. 产物新鲜度：`node tools/assert-artifacts.mjs`——`lib/` 比 `src/` 旧时拦下。
#      放在包检查之后：多数包的 check 自带构建，各自修好了才轮到这道。
#
# 装法（仓库根执行一次）：
#   git config core.hooksPath .githooks
# 装完钩子随仓库走，克隆出来配上这一行即可；不想装就 `git config --unset core.hooksPath`。
#
# 跳过一次（确定只是文档/无法本地跑的场合）：`SKIP_CHECK=1 git commit ...`

set -u

if [ "${SKIP_CHECK:-0}" = "1" ]; then
  echo "pre-commit: SKIP_CHECK=1，跳过全部检查"
  exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

# 暂存区里改动的路径（新增/修改/删除都算）。
# **必须带上 D**：只删不增的提交（删包、删文件）如果被过滤掉，`changed` 就是空的，下面
# 直接 exit 0——台账与产物新鲜度两道闸门一次都不跑，删了包却留着根 README 那行这类事
# 会静默放行。包检查那一节对已删目录本来就有 `[ -f "$pkg/package.json" ] || continue` 兜着。
changed=$(git diff --cached --name-only --diff-filter=ACMRD) || exit 0
[ -n "$changed" ] || exit 0

# 本次改动触及的包目录（plugins/<dir>、presets/<dir>），去重。
pkgs=$(printf '%s\n' "$changed" \
  | grep -E '^(plugins|presets)/[^/]+/' \
  | cut -d/ -f1,2 \
  | sort -u)

failed=""

# ── 0. 内核基线 ──────────────────────────────────────────────────────────────
# 放在台账之前：它抓的是「整仓落后一版」，台账抓的是「包内与包间不一致」，前者更根本。
# 只比本次改动的包，理由见文件头。
if printf '%s\n' "$changed" | grep -qE '^(plugins|presets)/'; then
  # 已删除的包目录不在 listPackages 里，别传给 --only：删包提交要能过。
  baseline_pkgs=$(printf '%s\n' "$pkgs" | while IFS= read -r pkg; do
    [ -n "$pkg" ] && [ -f "$pkg/package.json" ] && printf '%s\n' "$pkg"
  done)
  if [ -n "$baseline_pkgs" ]; then
    only=$(printf '%s' "$baseline_pkgs" | tr '\n' ',')
    only=${only%,}
    echo "pre-commit: 内核基线 -> node tools/dsh-baseline.mjs --check --only $only"
    out=$(node tools/dsh-baseline.mjs --check --only "$only" 2>&1)
  else
    echo "pre-commit: 内核基线 -> node tools/dsh-baseline.mjs --check"
    out=$(node tools/dsh-baseline.mjs --check 2>&1)
  fi
  code=$?
  if [ "$code" = "2" ]; then
    echo "pre-commit: 提示：读不到在用的内核，跳过基线检查（本机没装 DSH 时正常）"
  elif [ "$code" != "0" ]; then
    echo "pre-commit: 有包没跟到在用内核："
    printf '%s\n' "$out" | tail -n 20
    failed="$failed 内核基线"
  fi
fi

# ── 1. 仓库级台账 ────────────────────────────────────────────────────────────
if printf '%s\n' "$changed" | grep -qE '^(plugins|presets)/|^README\.md$|^docs/rules/|^tools/'; then
  echo "pre-commit: 台账 -> node tools/assert-ledger.mjs"
  if ! out=$(node tools/assert-ledger.mjs --quiet 2>&1); then
    echo "pre-commit: 台账不一致："
    printf '%s\n' "$out" | tail -n 40
    failed="$failed 台账"
  fi
fi

# ── 2. 本次改动触及的包 ──────────────────────────────────────────────────────
for pkg in $pkgs; do
  [ -f "$pkg/package.json" ] || continue

  # 这个包有没有 check：没有就跳过，让它自己的 README/约定说了算。
  if ! grep -q '"check"' "$pkg/package.json" 2>/dev/null; then
    echo "pre-commit: $pkg 没有 check 脚本，跳过"
    continue
  fi

  echo "pre-commit: $pkg -> pnpm check"
  # 依赖没装不再是跳过的理由：preset 的 check 不需要依赖，而漏跑一道闸门比跑失败更贵。
  if [ ! -d "$pkg/node_modules" ]; then
    echo "pre-commit: 提示：$pkg 没有 node_modules，check 若需要依赖就先 cd $pkg && pnpm install"
  fi

  # 成功时不回放输出：那是两百多行 ok 清单，纯噪声——钩子的输出会原样进调用方（含
  # agent）的上下文，那边压不掉。失败才回放末尾，够看清是哪几条红的。
  if ! out=$(cd "$pkg" && pnpm check 2>&1); then
    echo "pre-commit: $pkg 的 check 没过，输出末尾 40 行："
    printf '%s\n' "$out" | tail -n 40
    failed="$failed $pkg"
  fi
done

# ── 3. 产物新鲜度 ────────────────────────────────────────────────────────────
# 放在各包的 check 之后：多数包的 check 自带构建，跑完自己就修好了。这里抓的是「check 跑完
# 产物还是比 src/ 旧」——那说明这个包的 check 不构建、而它的自检里有读 lib/ 的脚本。
echo "pre-commit: 产物新鲜度 -> node tools/assert-artifacts.mjs"
if ! out=$(node tools/assert-artifacts.mjs 2>&1); then
  echo "pre-commit: 构建产物比源码旧："
  printf '%s\n' "$out" | tail -n 20
  failed="$failed 产物新鲜度"
fi

if [ -n "$failed" ]; then
  echo ""
  echo "pre-commit: 没过的检查：${failed}"
  echo "修好再提交；确定要跳过这一次就 SKIP_CHECK=1 git commit ..."
  exit 1
fi

# 变量写成 ${}：紧跟全角括号时，macOS 的 /bin/sh（bash 3.2）会把括号的首字节吞进变量名，
# set -u 下直接以 unbound variable 崩掉——检查全过的提交反而被这道闸门自己拦住。
# 多个包折成一行：成功路径只打一行，调用方（尤其 agent）那边才压得住。
pkgs_line=$(printf '%s' "${pkgs:-仅台账}" | tr '\n' ' ')
echo "pre-commit: 通过（${pkgs_line% }）"
exit 0
