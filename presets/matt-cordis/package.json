{
  "name": "@lynn123411/dsh-preset-matt-cordis",
  "version": "0.1.5",
  "description": "官方 cordis 组合（persona 零改动，含 tool-cordis 动态插件工具集与官方随附 4 个技能）＋ Matt Pocock 的 26 个技能并入 skills/ ＋ grilling 表单工具（grilling_form）。grilling 轮次把整轮问题一次投成对话里的表单、当轮即结束；原生 ask_user_question 保留给简单确认。达成共识后不自动进入 plan mode。",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "skills",
    "matt-cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@lynn123411/dsh-ask-user-grilling": "^0.7.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-preset",
    "agent-preset",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tttnny/my-dsh.git",
    "directory": "presets/matt-cordis"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./matt-cordis.patch.yml"
    }
  }
}
