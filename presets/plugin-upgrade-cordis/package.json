{
  "name": "@lynn123411/dsh-preset-plugin-upgrade-cordis",
  "version": "0.1.5",
  "description": "插件升级创造模式：官方 cordis 组合（persona、工具矩阵、计划 / 压缩 / 子代理编排、动态插件工具）逐字保留，另并入 dsh-plugin-upgrade-skill 的 11 个插件工程技能（升级迁移、编写、测试、发布、运行时排障、整队巡检、重依赖接入、DSH 版本兼容审计、benchmark 考题提取、通用迁移方法、生命周期编排）。",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "skills",
    "upstream",
    "check-upstream.mjs",
    "upstream-lock.json",
    "plugin-upgrade-cordis.patch.yml",
    "README.md",
    "UPSTREAM.md",
    "DETAILS.md"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node check-upstream.mjs --verify"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-preset",
    "agent-preset",
    "cordis",
    "plugin-upgrade"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tttnny/my-dsh.git",
    "directory": "presets/plugin-upgrade-cordis"
  },
  "engines": {
    "dsh": ">=0.2.1-alpha.4",
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin-upgrade-cordis.patch.yml"
    }
  }
