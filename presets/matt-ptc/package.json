{
  "name": "@lynn123411/dsh-preset-matt-ptc",
  "version": "0.1.1",
  "description": "官方 ptc 组合（persona 零改动，模型只见 run_code）＋ Matt Pocock 的 26 个技能（skills/）＋ grilling 投递插件。grilling 轮次经 run_code 内的 tools.ask_user_grilling 投递；达成共识后不自动进入 plan mode。",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "skills",
    "matt-ptc.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@lynn123411/dsh-ask-user-grilling": "^0.6.2"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-preset",
    "agent-preset",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tttnny/my-dsh.git",
    "directory": "presets/matt-ptc"
  },
  "engines": {
    "dsh": "0.1.7-rc.2",
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./matt-ptc.patch.yml"
    }
  }
}
