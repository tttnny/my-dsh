{
  "name": "@lynn123411/dsh-browseros-neo",
  "version": "1.0.0",
  "description": "Zero-config BrowserOS neo MCP mount: resolves the real endpoint from ~/.browserclaw/runtime.json and mounts the official @deepseek-ai/dsh-mcp-client bridge — configuration, nothing more.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.3-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
