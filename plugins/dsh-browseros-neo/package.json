{
  "name": "@lynn123411/dsh-browseros-neo",
  "version": "0.7.0",
  "description": "Zero-config BrowserOS neo integration: mounts the official @deepseek-ai/dsh-mcp-client for the neo MCP server, keeps working when neo starts late, and adds browseros_neo_launch so agents can wake the browser up themselves.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
