{
  "name": "@lynn123411/dsh-model-submenu",
  "version": "0.3.13",
  "description": "增强输入框的模型菜单：第一行直接打开跨供应商的模型弹窗，第二行的推理等级是可拖动的滑块，档位带配色。",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "cordis.patch.yml",
    "README.md",
    "locale",
    "assets",
    "DETAILS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "smoke": "node scripts/smoke-client.mjs",
    "assert:lib-untracked": "node scripts/assert-lib-untracked.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm smoke && pnpm test && pnpm assert:lib-untracked",
    "test": "node scripts/test-favorites.mjs && node scripts/test-facts.mjs && node scripts/test-commit.mjs && node scripts/test-rows.mjs && node scripts/test-effort-memory.mjs && node scripts/test-slider.mjs && node scripts/test-render.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.3",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "icon": "./assets/icon.svg"
}
