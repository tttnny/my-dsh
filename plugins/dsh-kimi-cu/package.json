{
  "name": "@lynn123411/dsh-kimi-cu",
  "version": "0.2.0",
  "description": "接上本机 KimiCU（macOS / Windows）：把它的 mcp 服务挂成 mcp__kimi-cu__* 工具，随包带操作技能，并在插件页给出安装检测与引导。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "locale",
    "assets",
    "scripts",
    "README.md",
    "DETAILS.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "mcp",
    "kimi-cu",
    "computer-use"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tttnny/my-dsh.git",
    "directory": "plugins/dsh-kimi-cu"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node build.mjs && node scripts/smoke-host.mjs && node scripts/smoke-client.mjs && node scripts/test-status.mjs && node scripts/test-card.mjs",
    "assert:lib-untracked": "node scripts/assert-lib-untracked.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm assert:lib-untracked && node scripts/check-bundle.mjs && node ../../tools/probes/preset-skills.mjs --skills skills/macos && node ../../tools/probes/preset-skills.mjs --skills skills/windows"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "icon": "./assets/icon.svg"
}
