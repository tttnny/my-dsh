{
  "name": "@lynn123411/dsh-kimi-cu",
  "version": "0.1.0",
  "description": "接上本机 KimiCU：把它的 mcp 服务挂成 mcp__kimi-cu__* 工具，并随包带一份 kimi-cu 操作技能。",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "cordis.patch.yml",
    "skills",
    "locale",
    "assets",
    "scripts",
    "README.md",
    "DETAILS.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "mcp",
    "kimi-cu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tttnny/my-dsh.git",
    "directory": "plugins/dsh-kimi-cu"
  },
  "scripts": {
    "test": "node scripts/check-bundle.mjs",
    "check": "node scripts/check-bundle.mjs && node ../../tools/probes/preset-skills.mjs --skills skills"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./assets/icon.svg"
}
