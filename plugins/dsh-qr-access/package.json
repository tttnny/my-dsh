{
  "name": "@lynn123411/dsh-qr-access",
  "version": "0.1.0",
  "description": "DSH 扫码访问：设置页实时生成局域网 HTTPS 访问地址与本地 CA 证书二维码，手机扫码直连，免复制粘贴；地址实时跟随 DSH 重启后的 token 轮换。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tttnny/my-dsh.git",
    "directory": "plugins/dsh-qr-access"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "qr",
    "qrcode",
    "lan",
    "https",
    "mobile",
    "scan"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  }
}
