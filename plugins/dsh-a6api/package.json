{
  "name": "@lynn123411/dsh-a6api",
  "version": "1.8.5",
  "description": "A6API 多模型聚合站接入插件：原生 LLM 提供商注册、账户实时余额与价格波动监控、Token 白名单同步、商户线路探测与全景指标卡片",
  "license": "MIT",
  "author": "lynn123411",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tttnny/my-dsh.git",
    "directory": "plugins/dsh-a6api"
  },
  "homepage": "https://github.com/tttnny/my-dsh#readme",
  "bugs": {
    "url": "https://github.com/tttnny/my-dsh/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "a6api",
    "llm-provider",
    "marketplace",
    "web-ui"
  ],
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "DETAILS.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-client.mjs",
    "test:sync": "node scripts/test-sync-settings.mjs",
    "test:probe-protocol": "node scripts/test-probe-protocol.mjs",
    "test:auth-bootstrap": "node scripts/test-auth-bootstrap.mjs",
    "test:reasoning-source": "node scripts/test-reasoning-source.mjs",
    "assert:lib-untracked": "node scripts/assert-lib-untracked.mjs",
    "assert:lib-mirror": "node scripts/assert-lib-mirror.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm smoke && pnpm test:sync && pnpm test:probe-protocol && pnpm test:auth-bootstrap && pnpm test:reasoning-source && pnpm assert:lib-untracked && pnpm assert:lib-mirror"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  }
}
