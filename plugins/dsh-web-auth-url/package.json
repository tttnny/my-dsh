{
  "name": "@lynn123411/dsh-web-auth-url",
  "version": "0.5.4",
  "description": "给模型一个 web_gui_login 工具：每次调用即时解析出本进程带 launch token 的 GUI 地址，模型用它换一次浏览器会话 cookie，之后走 DSH_WEB_URL。同时托管 DSH_WEB_AUTH_URL。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "locale",
    "assets",
    "DETAILS.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "web",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tttnny/my-dsh.git",
    "directory": "plugins/dsh-web-auth-url"
  },
  "scripts": {
    "test": "node scripts/smoke-host.mjs",
    "check": "node scripts/smoke-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-error": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-error": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-shell-env": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-native": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3",
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./assets/icon.svg"
}
